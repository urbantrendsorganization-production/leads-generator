# Docker Compose variable substitution (TEMPLATE).
# Copy to .env and fill in real values:
#     cp .env.example .env
#
# These are injected as build args into the frontend image at build time.
# Backend secrets go in .env.docker, not here.

NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
