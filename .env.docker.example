# ─────────────────────────────────────────────────────────────────────────────
# TrendyyLeads — backend environment for the Docker stack (TEMPLATE).
#
# Copy this file to `.env.docker` and fill in real values:
#     cp .env.docker.example .env.docker
#
# `.env.docker` is git-ignored and is loaded by the `backend` service via
# `env_file` in docker-compose.yml. Never commit real secrets.
#
# DATABASE_URL uses the in-network hostname `db` and internal port 5432.
# Its user/password/database MUST match the POSTGRES_* values of the db
# service defined in docker-compose.yml.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection (in-Docker hostname + internal port)
DATABASE_URL=postgresql://urbanleads:urbanleads_dev@db:5432/urbanleads

# Secret used to sign JWTs — generate a strong random value:
#   openssl rand -base64 32
JWT_SECRET=replace-with-a-strong-random-secret

# Backend HTTP port (must match the container EXPOSE and docker-compose port mapping)
PORT=3001

# Public URL of the frontend — used for CORS and redirect links
FRONTEND_URL=https://trendyyleads.com

# Node runtime environment
NODE_ENV=production

# Optional: Hunter.io API key — enriches leads with verified contacts
HUNTER_API_KEY=

# Optional: WhatsApp Business API credentials
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Required for Google OAuth login
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Required for the local business search feature (Google Places API)
GOOGLE_PLACES_API_KEY=

# Required for outreach emails (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=outreach@trendyyleads.com
EMAIL_SUPPORT=support@trendyyleads.com

# Internal URL used by the backend to build tracking pixel/links in emails
BACKEND_URL=https://api.trendyyleads.com

# Optional: comma-separated extra CORS origins beyond FRONTEND_URL
ALLOWED_ORIGINS=
